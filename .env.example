# Canonical full template. For seed profiles use:
#   .env.smoke.example  → tiny AI seed (fast reset loops)
#   .env.normal.example → fuller demo directory
# Local copies live at apps/api/.env.smoke / .env.normal.
#   pnpm db:reset              # empty migrated DB
#   pnpm db:seed:smoke|normal  # activate profile + seed
#   pnpm env:smoke|normal      # activate without seeding
#
# Or copy this file once: cp .env.example apps/api/.env

# --- App ---
NODE_ENV=development
# lebanon (local default) · worldwide (production default). Override explicitly if needed.
HUB_MARKET=lebanon
# Web build-time mirror of HUB_MARKET (Vite). Omit → lebanon in dev, worldwide in prod builds.
# VITE_HUB_MARKET=lebanon
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=3001

# --- Database ---
# Local docker (dedicated DB — schema still creative_hub for parity with staging):
DATABASE_URL=postgresql://creativehub:creativehub@localhost:5433/creativehub
#
# Staging on shared Supabase "My Stuff": use the project connection string.
# Tables live in schema `creative_hub` (not public) so blog/other apps stay isolated.
# Example:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
#
# VPS later (millions of visitors): provision plain Postgres, keep schema `creative_hub`
# (pg_dump --schema=creative_hub | psql …), point DATABASE_URL at the VPS — no app rewrite.

# --- Redis (sessions + rate limits only) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_SECONDS=604800
CSRF_SECRET=change-me-csrf-secret-at-least-32-chars
MAGIC_LINK_TTL_SECONDS=900
CLAIM_TOKEN_TTL_DAYS=7

# --- Media (Supabase Storage via adapter) ---
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=media

# --- Mail (Resend via Mailer adapter) ---
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM="Creative Hub <noreply@example.com>"

# --- Observability (optional) ---
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
PUBLIC_ANALYTICS_KEY=
PERF_LITE_DEFAULT=false

# --- Seed / admin bootstrap ---
ADMIN_EMAIL=admin@creativehub.local
ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_QUOTA_CREATORS=8
SEED_QUOTA_WORKS=8

# --- AI seed (PubFana-style multi-provider gateway) ---
# live | stub  (omit → live when OPENROUTER_API_KEY is set)
SEED_AI_MODE=
#
# Cost mode — exactly one of:
#   free  → OpenRouter free text · Pixazo/Free.ai image/video · ElevenLabs free TTS audio
#   paid  → fal (media+music) · Replicate · HF · OpenRouter Lyria · ElevenLabs
SEED_AI_COST_MODE=free
#
# How many AI media assets / LLM creator packs to generate per seed (keep low for smoke)
SEED_AI_TEXT_COUNT=8
SEED_AI_IMAGE_COUNT=1
SEED_AI_VIDEO_COUNT=1
SEED_AI_AUDIO_COUNT=1

# --- FREE-mode keys ---
# Text: https://openrouter.ai/
OPENROUTER_API_KEY=
# Leave empty to use cost-mode default: free → openrouter/free · paid → openai/gpt-4o-mini
OPENROUTER_MODEL=
OPENROUTER_MUSIC_MODEL=
OPENROUTER_TIMEOUT_MS=90000
# Images + video: https://www.pixazo.ai/api/free
PIXAZO_API_KEY=
PIXAZO_TIMEOUT_MS=120000
# Images + video: https://free.ai/api/
FREEAI_API_KEY=
FREEAI_TIMEOUT_MS=180000

# --- Free spoken audio (TTS) — https://elevenlabs.io/app/settings/api-keys ---
# Free plan: TTS API OK. Music Compose (/v1/music) needs paid plan — we try music then fall back to TTS.
# https://elevenlabs.io/docs/api-reference/music/compose
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_PREFER_MUSIC=1
ELEVENLABS_TIMEOUT_MS=180000

# --- Optional paid music paths ---
# https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MUSIC_MODEL=facebook/musicgen-small
HF_AUDIO_ENDPOINT=
HF_TIMEOUT_MS=180000
# https://replicate.com/meta/musicgen  (~$0.06/run)
REPLICATE_API_TOKEN=
REPLICATE_TIMEOUT_MS=180000

# --- PAID-mode keys ---
# https://fal.ai/
FAL_KEY=
FAL_AUDIO_MODEL=
FAL_TIMEOUT_MS=180000
