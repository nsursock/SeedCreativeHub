# Smoke profile — tiny seed for fast AI / reset loops.
# Setup:
#   cp .env.smoke.example apps/api/.env.smoke
#   # fill provider keys (same as normal)
#   pnpm db:seed:smoke   # activates this profile + seeds
#   pnpm env:smoke       # activate without seeding
#
# Diff vs normal: 2 creators / 2 works · live text=2 · image/video=0 · audio=1

# --- App ---
NODE_ENV=development
HUB_MARKET=lebanon
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
HOST=0.0.0.0
PORT=3001

# --- Database ---
DATABASE_URL=postgresql://creativehub:creativehub@localhost:5433/creativehub

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_SECONDS=604800
CSRF_SECRET=change-me-csrf-secret-at-least-32-chars
MAGIC_LINK_TTL_SECONDS=900
CLAIM_TOKEN_TTL_DAYS=7

# --- Media ---
STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Mail ---
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="Creative Hub <noreply@example.com>"

# --- Observability ---
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
PUBLIC_ANALYTICS_KEY=
PERF_LITE_DEFAULT=false

# --- Seed / admin ---
ADMIN_EMAIL=admin@creativehub.local
ADMIN_PASSWORD=ChangeMeAdmin123!
SEED_QUOTA_CREATORS=2
SEED_QUOTA_WORKS=2

# --- AI seed (smoke) ---
SEED_AI_MODE=live
SEED_AI_COST_MODE=free
SEED_AI_TEXT_COUNT=2
SEED_AI_IMAGE_COUNT=0
SEED_AI_VIDEO_COUNT=0
SEED_AI_AUDIO_COUNT=1

# --- FREE-mode keys ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MUSIC_MODEL=google/lyria-3-clip-preview
OPENROUTER_TIMEOUT_MS=90000
PIXAZO_API_KEY=
PIXAZO_TIMEOUT_MS=120000
FREEAI_API_KEY=
FREEAI_TIMEOUT_MS=180000

# --- Free spoken audio (TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=
ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_PREFER_MUSIC=1
ELEVENLABS_TIMEOUT_MS=180000

# --- Optional paid music paths ---
HF_TOKEN=
HF_MUSIC_MODEL=facebook/musicgen-small
HF_AUDIO_ENDPOINT=
HF_TIMEOUT_MS=180000
REPLICATE_API_TOKEN=
REPLICATE_TIMEOUT_MS=180000

# --- PAID-mode keys ---
FAL_KEY=
FAL_AUDIO_MODEL=fal-ai/lyria3
FAL_TIMEOUT_MS=180000
