# Staging secrets template — NEVER commit real values.
# Setup (local only; do not paste secrets into chat):
#   cp .env.staging.example apps/api/.env.staging
#   # fill DATABASE_PASSWORD + SUPABASE_SECRET_KEY from Supabase dashboard
#   pnpm env:staging:check
#   pnpm db:migrate:staging
#
# Target: Supabase "My Stuff" · region eu-west-1 · schema creative_hub · bucket media
# Project URL: https://fhluaxnbdrgilkhaoduc.supabase.co
#
# Connection: API/runtime → transaction pooler :6543 (pgbouncer).
# Migrations/seed may use session :5432; the API auto-rewrites 5432→6543.
# Password lives in DATABASE_PASSWORD only.
# Does NOT replace apps/api/.env (local docker). Staging commands load this file
# with override so local smoke/normal profiles stay untouched.

# --- App (Railway will set these for the live API) ---
NODE_ENV=production
# HUB_MARKET=worldwide   # product choice — not required for infra milestone
PUBLIC_APP_URL=https://YOUR-VERCEL-STAGING.vercel.app
PUBLIC_API_URL=https://YOUR-VERCEL-STAGING.vercel.app
# Browser hits Vercel origin; proxy forwards /graphql + /health to Railway.
CORS_ORIGINS=https://YOUR-VERCEL-STAGING.vercel.app
HOST=0.0.0.0
PORT=3001

# --- Database (Supabase My Stuff — pooler; password separate) ---
DATABASE_HOST=aws-1-eu-west-1.pooler.supabase.com
# Runtime / Railway: 6543 (transaction). Session 5432 only if you must (migrate).
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.fhluaxnbdrgilkhaoduc
# Put the DB password here only (file/secret store — never in chat):
DATABASE_PASSWORD=
# Assembled at runtime if DATABASE_URL is empty; or use template with placeholder:
DATABASE_URL=postgresql://postgres.fhluaxnbdrgilkhaoduc:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
# Cap Prisma pool size (also applied by apps/api/src/db.ts when missing)
DATABASE_CONNECTION_LIMIT=5

# --- Redis (Railway — fill when Redis service exists) ---
REDIS_URL=

# --- Auth (generate locally; never reuse local docker secrets in staging) ---
SESSION_SECRET=
CSRF_SECRET=
SESSION_TTL_SECONDS=604800
MAGIC_LINK_TTL_SECONDS=900
CLAIM_TOKEN_TTL_DAYS=7

# --- Media (Supabase Storage) ---
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://fhluaxnbdrgilkhaoduc.supabase.co
# Dashboard → API Keys → Secret key (not Publishable; not legacy service_role)
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Mail (optional for infra milestone) ---
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM="Creative Hub <noreply@example.com>"
